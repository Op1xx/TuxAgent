#TuxAgentWindow { background: #09090b; }
QWidget { font-family: "IBM Plex Mono"; font-size: 13px; color: #e8e5ed; }

/* ── основная панель: фон + свечение + виньетка ── */
QFrame#main {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d0d10, stop:0.7 #080809, stop:1 #080809);
  border: 1px solid #29262e; border-left-color: #4a444f;
}
QFrame#mainGlow {
  border: 0;
  background: qradialgradient(cx:0.48, cy:0.43, radius:0.33, fx:0.48, fy:0.43,
              stop:0 rgba(88,62,112,26), stop:1 rgba(88,62,112,0));
}
QFrame#mainVignette {
  border: 0;
  background: qradialgradient(cx:0.55, cy:0.43, radius:0.85, fx:0.55, fy:0.43,
              stop:0 rgba(0,0,0,0), stop:0.55 rgba(0,0,0,31), stop:1 rgba(0,0,0,184));
}

/* ── верхняя панель ── */
QFrame#topbar { background: transparent; border: 0; border-bottom: 1px solid #242229; }
QLabel#promptMark { color: #a477ed; font-size: 18px; font-weight: 700; }
QLabel#brandSmall { font-family: "Space Grotesk"; font-size: 13px; font-weight: 600; color: #dddddd; }
QPushButton#menuBtn, QPushButton#tasksBtn { border: 1px solid #38343e; background: #151419;
  color: #aaa5b1; border-radius: 4px; padding: 5px 9px; font-family: Arial; font-size: 13px; }
QPushButton#menuBtn:hover, QPushButton#tasksBtn:hover { border-color: #8a6cb0; color: #f1ecf7; }
QPushButton#menuBtn[active="true"], QPushButton#tasksBtn[active="true"] {
  background: #1d1924; border-color: #8a6cb0; color: #f1ecf7; }
QPushButton#btnMin, QPushButton#btnMax, QPushButton#btnClose {
  background: #141319; border: 1px solid #38343e; border-radius: 4px; padding: 0;
  color: #aaa5b1; font-family: Arial; font-size: 18px; }
QPushButton#btnMin:hover, QPushButton#btnMax:hover, QPushButton#btnClose:hover {
  background: #1d1924; border-color: #8a6cb0; color: #f1ecf7; }
QPushButton#btnMin:pressed, QPushButton#btnMax:pressed {
  background: #262030; border-color: #a477ed; color: #ffffff; }
QPushButton#btnClose { font-size: 20px; }
QPushButton#btnClose:hover { background: #3b1d27; border-color: #a4414f; color: #ff8b9a; }
QPushButton#btnClose:pressed { background: #562431; border-color: #c14e5f; color: #ffffff; }
QToolTip { background: #17141d; color: #e8e5ed; border: 1px solid #3a3444;
  padding: 4px 7px; font-size: 11px; }

QStackedWidget#stack, QWidget#welcomePage, QWidget#conversationPage, QWidget#logoWrap,
QWidget#hintRow { background: transparent; }

/* ── приветствие ── */
QLabel#watermark { font-size: 145px; color: rgba(41,35,47,92); }
QLabel#titleTux, QLabel#titleAgent { font-family: "Space Grotesk"; font-size: 76px; font-weight: 700; }
QLabel#titleTux { color: #e8e5ed; }
QLabel#titleAgent { color: #a477ed; }
QLabel#tagline { color: #77727e; font-size: 11px; }

QFrame#promptFrame { background: rgba(17,16,21,224); border: 1px solid #49424f;
  border-left: 3px solid #a477ed; border-radius: 4px; }
QFrame#promptFrame[focused="true"] { border: 1px solid #8963b7; border-left: 3px solid #8963b7; }
QLabel[terminal="true"] { color: #a477ed; font-size: 19px; font-weight: 600; }
QTextEdit { background: transparent; border: 0; color: #eeeeee; font-size: 13px;
  padding: 8px 0; selection-background-color: #7548b9; }
QPushButton[send="true"] { background: #a477ed; color: #120d18; border: 0; border-radius: 3px;
  font-family: Arial; font-size: 20px; }
QPushButton[send="true"]:hover { background: #c09bff; }
QLabel[kbd="true"] { color: #aaa4b0; border: 1px solid #37333c; border-radius: 3px;
  padding: 2px 5px; font-size: 10px; }
QLabel[hint="true"] { color: #5f5b65; font-size: 10px; }

/* ── диалог ── */
QFrame#sessionTabs { background: transparent; border: 0; border-bottom: 1px solid #242229; }
QLabel#sessionTab { color: #e6e0ec; font-size: 11px; padding: 6px 2px 5px 2px; border: 0;
  border-bottom: 2px solid #a477ed; }
QScrollArea { background: transparent; border: 0; }
QScrollArea > QWidget, QScrollArea > QWidget > QWidget { background: transparent; }

QLabel[kind] { font-size: 11px; }
QLabel[kind="info"]    { background: #141319; border: 1px solid #24212b; border-left: 4px solid #292330;
  padding: 12px 14px 12px 11px; color: #aaa5b1; }
QLabel[kind="command"] { background: #111015; border: 1px solid #24212b; border-left: 4px solid #292330;
  padding: 12px 14px 12px 11px; color: #d5d0da; }
QLabel[kind="thought"] { background: transparent; border: 0; padding: 2px 14px; color: #8b7a60; }
QLabel[kind="answer"]  { background: #17141d; border: 1px solid #24212b; border-left: 2px solid #a477ed;
  padding: 15px 16px; color: #e4dfea; }

QFrame#composeFrame { background: rgba(17,16,21,240); border: 1px solid #49424f;
  border-left: 3px solid #a477ed; }

/* ── панель задач ── */
QFrame#tasksPanel { background: rgba(13,13,16,245); border: 1px solid #29262e;
  border-right: 1px solid #39313f; }
QLabel#tasksTitle { font-family: "Space Grotesk"; font-size: 18px; font-weight: 600; }
QLabel#tasksChat { color: #c6c1cb; font-size: 12px; padding: 14px 0 4px 0; }
QLabel#tasksContext { color: #716c78; font-size: 10px; }
QLabel#tasksEmpty { color: #5f5b65; font-size: 10px; padding: 8px 0; }
QFrame[task="true"] { background: transparent; border: 1px solid transparent;
  border-left: 3px solid #3a3444; border-radius: 4px; }
QFrame[task="true"]:hover { background: #17151c; border-color: #302b36;
  border-left-color: #5f5b65; }
QFrame[task="true"][status="running"] { background: #17141d; border-color: #302b36;
  border-left-color: #a477ed; }
QFrame[task="true"][status="done"] { border-left-color: #78c99a; }
QFrame[task="true"][status="error"] { border-left-color: #e14b5a; }
QLabel[taskMarker="true"] { font-size: 14px; color: #716c78; background: transparent; border: 0; }
QLabel[taskTitle="true"] { font-size: 11px; color: #c6c1cb; background: transparent; border: 0; }
QLabel[taskDetail="true"] { font-size: 10px; color: #716c78; background: transparent; border: 0; }
QFrame[task="true"][status="running"] QLabel[taskMarker="true"] { color: #a477ed; }
QFrame[task="true"][status="done"] QLabel[taskMarker="true"] { color: #78c99a; }
QFrame[task="true"][status="error"] QLabel[taskMarker="true"] { color: #ff8b9a; }

/* ── сайдбар ── */
QFrame#sidebar { background: rgba(13,13,16,245); border: 1px solid #29262e; border-left: 1px solid #39313f; }
QLabel#sideTitle { font-family: "Space Grotesk"; font-size: 18px; font-weight: 600; }
QPushButton[iconBtn="true"] { border: 1px solid #38343e; background: #151419; color: #aaa5b1;
  border-radius: 4px; font-family: Arial; font-size: 17px; }
QPushButton[iconBtn="true"]:hover { border-color: #a477ed; color: #ffffff; }

QFrame[chat="true"] { background: transparent; border: 1px solid transparent;
  border-left: 3px solid transparent; border-radius: 4px; }
QFrame[chat="true"]:hover { background: #17151c; border-color: #302b36; }
QFrame[chat="true"][active="true"] {
  background: qlineargradient(x1:0, y1:0.41, x2:1, y2:0.59, stop:0 #211a2b, stop:1 #17141c);
  border: 1px solid #75549a; border-left: 3px solid #a477ed; }
QLabel[chatIcon="true"] { color: #9d97a4; font-size: 17px; background: transparent; border: 0; }
QLabel[chatName="true"] { color: #c6c1cb; font-size: 12px; background: transparent; border: 0; }
QLabel[chatTime="true"] { color: #716c78; font-size: 10px; background: transparent; border: 0; }
QFrame[dot="true"] { background: #a477ed; border: 0; border-radius: 3px; }
QPushButton[chatDelete="true"] { background: transparent; border: 0; color: #5f5b65;
  font-family: Arial; font-size: 15px; padding: 0; }
QPushButton[chatDelete="true"]:hover { background: #2a1a20; border-radius: 3px; color: #ff8b9a; }

QFrame#sideBottom { background: transparent; border: 0; border-top: 1px solid #302c34; }
QPushButton#settingsBtn { background: transparent; border: 0; color: #aaa5b1; font-size: 12px;
  text-align: left; padding: 8px 7px; }
QPushButton#settingsBtn:hover { color: #ffffff; }
QWidget#statusRow { background: transparent; }
QFrame#statusDot { background: #5f5b65; border: 0; border-radius: 3px; }
QLabel#statusText { color: #77727e; font-size: 10px; }
QFrame#statusDot[state="idle"] { background: #5f5b65; }
QLabel#statusText[state="idle"] { color: #77727e; }
QFrame#statusDot[state="thinking"] { background: #a477ed; }
QLabel#statusText[state="thinking"] { color: #c9a7ff; }
QFrame#statusDot[state="running"] { background: #78c99a; }
QLabel#statusText[state="running"] { color: #78c99a; }
QFrame#statusDot[state="waiting"] { background: #e0b36a; }
QLabel#statusText[state="waiting"] { color: #e0b36a; }
QFrame#statusDot[state="error"] { background: #e14b5a; }
QLabel#statusText[state="error"] { color: #ff8b9a; }
QFrame#statusDot[state="done"] { background: #78c99a; }
QLabel#statusText[state="done"] { color: #78c99a; }

/* ── настройки ── */
QDialog#SettingsDialog { background: #09090b; }
QFrame#settingsTopbar { background: transparent; border: 0; border-bottom: 1px solid #242229; }
QLabel#settingsBrand { font-family: "Space Grotesk"; font-size: 13px; font-weight: 600; color: #dddddd; }
QScrollArea#settingsScroll { background: transparent; border: 0; }
QWidget#settingsContent { background: transparent; }
QLabel#settingsTitle { font-family: "Space Grotesk"; font-size: 28px; font-weight: 700; color: #e8e5ed; }
QLabel#settingsSubtitle { color: #77727e; font-size: 11px; }
QFrame#systemSection, QFrame#modelSection, QFrame#pathsSection, QFrame#uiSection { background: #111015; border: 1px solid #29262e;
  border-left: 3px solid #a477ed; border-radius: 4px; }
QLabel[sectionTitle="true"] { font-family: "Space Grotesk"; font-size: 15px; font-weight: 600; color: #e8e5ed; }
QLabel[sectionHint="true"] { color: #716c78; font-size: 10px; }
QLabel[fieldLabel="true"] { color: #aaa5b1; font-size: 11px; }
QLabel[fieldHint="true"] { color: #716c78; font-size: 10px; }
QComboBox, QLineEdit { background: #141319; border: 1px solid #38343e; border-radius: 3px;
  padding: 7px 9px; color: #e8e5ed; selection-background-color: #7548b9; }
QComboBox:hover, QLineEdit:hover { border-color: #8a6cb0; }
QComboBox:focus, QLineEdit:focus { border-color: #a477ed; }
QComboBox:disabled, QLineEdit:disabled { color: #5f5b65; border-color: #2a2730; background: #111015; }
QComboBox QAbstractItemView { background: #17141d; border: 1px solid #3a3444; color: #e8e5ed;
  selection-background-color: #2a2136; selection-color: #ffffff; outline: 0; }
QPushButton[browse="true"] { background: #151419; border: 1px solid #38343e; border-radius: 3px;
  color: #aaa5b1; padding: 7px 12px; }
QPushButton[browse="true"]:hover { border-color: #a477ed; color: #ffffff; }
QFrame#settingsFooter { background: transparent; border: 0; border-top: 1px solid #242229; }
QPushButton[primary="true"] { background: #a477ed; color: #120d18; border: 0; border-radius: 4px;
  padding: 9px 20px; font-family: Arial; font-weight: 600; }
QPushButton[primary="true"]:hover { background: #c09bff; }
QPushButton[primary="true"]:pressed { background: #8963b7; }
QPushButton[secondary="true"] { background: #151419; border: 1px solid #38343e; border-radius: 4px;
  color: #aaa5b1; padding: 9px 18px; }
QPushButton[secondary="true"]:hover { border-color: #8a6cb0; color: #f1ecf7; }
QPushButton[secondary="true"]:pressed { background: #262030; border-color: #a477ed; }
QMessageBox { background: #111015; }
QMessageBox QLabel { color: #e8e5ed; }
QMessageBox QPushButton { background: #151419; border: 1px solid #38343e; border-radius: 4px;
  color: #e8e5ed; padding: 7px 16px; min-width: 80px; }
QMessageBox QPushButton:hover { border-color: #a477ed; color: #ffffff; }

/* ── скроллбары ── */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #2c2833; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #3c3545; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
