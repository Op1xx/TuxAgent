  <property name="styleSheet">
   <string>#TuxAgentWindow { background: #09090b; }
QWidget { font-family: &quot;IBM Plex Mono&quot;; font-size: 13px; color: #e8e5ed; }

/* ── основная панель: фон + свечение + виньетка ── */
QFrame#main {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0d0d10, stop:0.7 #080809, stop:1 #080809);
  border: 1px solid #29262e; border-left-color: #4a444f;
}
QFrame#mainGlow {
  border: 0;
  background: qradialgradient(cx:0.48, cy:0.43, radius:0.33, fx:0.48, fy:0.43,
              stop:0 rgba(88,62,112,26), stop:1 rgba(88,62,112,0));
}
QFrame#mainVignette {
  border: 0;
  background: qradialgradient(cx:0.55, cy:0.43, radius:0.85, fx:0.55, fy:0.43,
              stop:0 rgba(0,0,0,0), stop:0.55 rgba(0,0,0,31), stop:1 rgba(0,0,0,184));
}

/* ── верхняя панель ── */
QFrame#topbar { background: transparent; border: 0; border-bottom: 1px solid #242229; }
QLabel#promptMark { color: #a477ed; font-size: 18px; font-weight: 700; }
QLabel#brandSmall { font-family: &quot;Space Grotesk&quot;; font-size: 13px; font-weight: 600; color: #dddddd; }
QPushButton#menuBtn { border: 1px solid #38343e; background: #151419; color: #aaa5b1;
  border-radius: 4px; padding: 5px 9px; font-family: Arial; font-size: 13px; }
QPushButton#btnMin, QPushButton#btnMax, QPushButton#btnClose {
  background: #141319; border: 1px solid #38343e; border-radius: 4px; padding: 0;
  color: #aaa5b1; font-family: Arial; font-size: 18px; }
QPushButton#btnMin:hover, QPushButton#btnMax:hover, QPushButton#btnClose:hover {
  background: #1d1924; border-color: #8a6cb0; color: #f1ecf7; }
QPushButton#btnMin:pressed, QPushButton#btnMax:pressed {
  background: #262030; border-color: #a477ed; color: #ffffff; }
QPushButton#btnClose { font-size: 20px; }
QPushButton#btnClose:hover { background: #3b1d27; border-color: #a4414f; color: #ff8b9a; }
QPushButton#btnClose:pressed { background: #562431; border-color: #c14e5f; color: #ffffff; }
QToolTip { background: #17141d; color: #e8e5ed; border: 1px solid #3a3444;
  padding: 4px 7px; font-size: 11px; }

QStackedWidget#stack, QWidget#welcomePage, QWidget#conversationPage, QWidget#logoWrap,
QWidget#hintRow { background: transparent; }

/* ── приветствие ── */
QLabel#watermark { font-size: 145px; color: rgba(41,35,47,92); }
QLabel#title { font-family: &quot;Space Grotesk&quot;; font-size: 76px; font-weight: 700; }
QLabel#tagline { color: #77727e; font-size: 11px; }

QFrame#promptFrame { background: rgba(17,16,21,224); border: 1px solid #49424f;
  border-left: 3px solid #a477ed; border-radius: 4px; }
QFrame#promptFrame[focused=&quot;true&quot;] { border: 1px solid #8963b7; border-left: 3px solid #8963b7; }
QLabel[terminal=&quot;true&quot;] { color: #a477ed; font-size: 19px; font-weight: 600; }
QTextEdit { background: transparent; border: 0; color: #eeeeee; font-size: 13px;
  padding: 8px 0; selection-background-color: #7548b9; }
QPushButton[send=&quot;true&quot;] { background: #a477ed; color: #120d18; border: 0; border-radius: 3px;
  font-family: Arial; font-size: 20px; }
QPushButton[send=&quot;true&quot;]:hover { background: #c09bff; }
QLabel[kbd=&quot;true&quot;] { color: #aaa4b0; border: 1px solid #37333c; border-radius: 3px;
  padding: 2px 5px; font-size: 10px; }
QLabel[hint=&quot;true&quot;] { color: #5f5b65; font-size: 10px; }

/* ── диалог ── */
QFrame#sessionTabs { background: transparent; border: 0; border-bottom: 1px solid #242229; }
QLabel#sessionTab { color: #e6e0ec; font-size: 11px; padding: 6px 2px 5px 2px; border: 0;
  border-bottom: 2px solid #a477ed; }
QScrollArea { background: transparent; border: 0; }
QScrollArea &gt; QWidget, QScrollArea &gt; QWidget &gt; QWidget { background: transparent; }

QLabel[kind] { font-size: 11px; }
QLabel[kind=&quot;info&quot;]    { background: #141319; border: 1px solid #24212b; border-left: 4px solid #292330;
  padding: 12px 14px 12px 11px; color: #aaa5b1; }
QLabel[kind=&quot;command&quot;] { background: #111015; border: 1px solid #24212b; border-left: 4px solid #292330;
  padding: 12px 14px 12px 11px; color: #d5d0da; }
QLabel[kind=&quot;thought&quot;] { background: transparent; border: 0; padding: 2px 14px; color: #8b7a60; }
QLabel[kind=&quot;answer&quot;]  { background: #17141d; border: 1px solid #24212b; border-left: 2px solid #a477ed;
  padding: 15px 16px; color: #e4dfea; }

QFrame#composeFrame { background: rgba(17,16,21,240); border: 1px solid #49424f;
  border-left: 3px solid #a477ed; }

/* ── сайдбар ── */
QFrame#sidebar { background: rgba(13,13,16,245); border: 1px solid #29262e; border-left: 1px solid #39313f; }
QLabel#sideTitle { font-family: &quot;Space Grotesk&quot;; font-size: 18px; font-weight: 600; }
QPushButton[iconBtn=&quot;true&quot;] { border: 1px solid #38343e; background: #151419; color: #aaa5b1;
  border-radius: 4px; font-family: Arial; font-size: 17px; }
QPushButton[iconBtn=&quot;true&quot;]:hover { border-color: #a477ed; color: #ffffff; }

QFrame[chat=&quot;true&quot;] { background: transparent; border: 1px solid transparent;
  border-left: 3px solid transparent; border-radius: 4px; }
QFrame[chat=&quot;true&quot;]:hover { background: #17151c; border-color: #302b36; }
QFrame[chat=&quot;true&quot;][active=&quot;true&quot;] {
  background: qlineargradient(x1:0, y1:0.41, x2:1, y2:0.59, stop:0 #211a2b, stop:1 #17141c);
  border: 1px solid #75549a; border-left: 3px solid #a477ed; }
QLabel[chatIcon=&quot;true&quot;] { color: #9d97a4; font-size: 17px; background: transparent; border: 0; }
QLabel[chatName=&quot;true&quot;] { color: #c6c1cb; font-size: 12px; background: transparent; border: 0; }
QLabel[chatTime=&quot;true&quot;] { color: #716c78; font-size: 10px; background: transparent; border: 0; }
QFrame[dot=&quot;true&quot;] { background: #a477ed; border: 0; border-radius: 3px; }

QFrame#sideBottom { background: transparent; border: 0; border-top: 1px solid #302c34; }
QPushButton#settingsBtn { background: transparent; border: 0; color: #aaa5b1; font-size: 12px;
  text-align: left; padding: 8px 7px; }
QPushButton#settingsBtn:hover { color: #ffffff; }
QWidget#statusRow { background: transparent; }
QFrame#statusDot { background: #78c99a; border: 0; border-radius: 3px; }
QLabel#statusText { color: #77727e; font-size: 10px; }

/* ── скроллбары ── */
QScrollBar:vertical { background: transparent; width: 8px; margin: 0; }
QScrollBar::handle:vertical { background: #2c2833; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #3c3545; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }</string>
